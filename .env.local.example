# --- Clerk ---------------------------------------------------------------

# Public key, safe to ship to the browser. Clerk Dashboard -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Secret key, server-only — used by @clerk/nextjs/server and clerkClient()
# (e.g. in the webhook route to update publicMetadata). Never expose to the
# client or commit it.
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Signing secret for the /api/webhooks/clerk endpoint. Clerk Dashboard ->
# Webhooks -> your endpoint -> Signing Secret. Used to verify requests are
# genuinely from Clerk (svix), not to authenticate users.
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_here

# Issuer URL of the "convex" JWT template. Clerk Dashboard -> JWT Templates
# -> convex -> Issuer. Convex's auth.config.ts uses this to verify tokens.
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# --- Convex ----------------------------------------------------------------

# Deployment URL, safe to ship to the browser. `npx convex dev` prints this,
# or find it in the Convex dashboard.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
